{
  "name": "w7-ai-decision-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:component": "vitest run tests/component --passWithNoTests",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:component && npm run test:e2e",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:watch": "playwright test --headed --workers=1 --timeout=0 --debug"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "inngest": "^4.20.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "openai": "^7.12.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
